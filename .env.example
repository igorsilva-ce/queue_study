# Copie este arquivo para .env e crie os arquivos em secrets/ antes de rodar:
# Copy-Item .env.example .env

# Django
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web
# Opcional: diretório para o banco SQLite (no Docker Compose já aponta para /app/data)
# DJANGO_DB_DIR=/app/data

# Usuário inicial da API (a senha e o token ficam em secrets/)
API_DEMO_USER=api_student

# RabbitMQ (Broker AMQP)
RABBITMQ_USER=celery_user
RABBITMQ_PASS=troque_esta_senha_forte_rabbitmq
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672

# Redis (DB 0 = Result Backend do Celery | DB 1 = Cache do Django e DRF)
REDIS_PASS=troque_esta_senha_forte_redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
